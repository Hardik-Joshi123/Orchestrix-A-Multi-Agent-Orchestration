# =============================================================================
# Multi-Agent Orchestrator - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and adjust values for your environment:
#     cp .env.example .env
#
# Sensible defaults are pre-configured so the entire system runs offline
# without external dependencies, live API keys, or paid services.
# DO NOT commit real secrets or live production credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM Provider Configuration
# -----------------------------------------------------------------------------
# Default provider: 'mock' (default, offline), 'openai', or 'anthropic'
DEFAULT_LLM_PROVIDER=mock

# Fallback provider if primary provider fails: 'mock' (default), 'openai', or 'anthropic'
FALLBACK_LLM_PROVIDER=mock

# Live API keys (Required ONLY if using 'openai' or 'anthropic' as primary/fallback)
# Leave empty for offline development with deterministic mock provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom pricing JSON override (dollars per 1M tokens)
# Format: '{"provider/model": {"input_cost_per_million": 3.0, "output_cost_per_million": 15.0}}'
LLM_CUSTOM_PRICING=

# -----------------------------------------------------------------------------
# 2. LLM Safety & Execution Limits
# -----------------------------------------------------------------------------
# Network call timeout per provider request in seconds
LLM_TIMEOUT_SECONDS=30.0

# Maximum provider retry attempts before degrading to fallback
LLM_MAX_RETRIES=2

# Maximum allowed task prompt length in characters
MAX_TASK_CHARS=8000

# -----------------------------------------------------------------------------
# 3. Specialist Concurrency & Resource Management
# -----------------------------------------------------------------------------
# Maximum number of specialist tasks executed in parallel (1 - 128)
MAX_SPECIALIST_CONCURRENCY=4

# -----------------------------------------------------------------------------
# 4. Workflow State & Local Persistence
# -----------------------------------------------------------------------------
# Enable durable SQLite checkpoint storage for workflow resume
CHECKPOINT_ENABLED=true

# Path to the SQLite checkpoint database file (must be on shared volume in distributed mode)
CHECKPOINT_DB_PATH=orchestrator_checkpoints.db

# Backup archive directory (relative or absolute)
BACKUP_DIR=backups

# Maximum number of backups to retain (0 to disable count pruning)
BACKUP_RETENTION_COUNT=10

# Maximum age in days for retained backups (0 to disable age pruning)
BACKUP_RETENTION_DAYS=30

# Enable automated periodic database backup scheduler (cross-process fenced)
BACKUP_SCHEDULER_ENABLED=false

# Interval in seconds between automated backup cycles (default: 86400 / 24 hours)
BACKUP_INTERVAL_SECONDS=86400

# Maximum duration in seconds for a backup operation before timeout
BACKUP_MAX_DURATION_SECONDS=300

# Maximum retry attempts on transient backup failure
BACKUP_MAX_RETRIES=3

# Initial exponential backoff in seconds for backup retries
BACKUP_RETRY_BACKOFF_SECONDS=5.0

# Maximum exponential backoff cap in seconds for backup retries
BACKUP_MAX_BACKOFF_SECONDS=60.0

# Cross-process leadership lease TTL in seconds for backup scheduling
BACKUP_SCHEDULER_LEASE_TTL_SECONDS=60.0

# Lease renewal heartbeat interval in seconds
BACKUP_SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=10.0

# Enable automated periodic database restore drill verification
RESTORE_DRILL_ENABLED=false

# Interval in seconds between automated restore drill runs (default: 604800 / 7 days)
RESTORE_DRILL_INTERVAL_SECONDS=604800

# Maximum allowed duration in seconds for a restore drill before timeout
RESTORE_DRILL_MAX_DURATION_SECONDS=300

# Maximum number of restore drill execution records retained in SQLite history
RESTORE_DRILL_HISTORY_LIMIT=50

# Cross-process leadership lease TTL in seconds for restore drill locks
RESTORE_DRILL_LEASE_TTL_SECONDS=60.0

# Cryptographic Backup Manifest Signing & Key Rotation (HMAC-SHA256)
# Active symmetric key secret for signing new backup manifests (leave empty to disable signing)
ORCHESTRATOR_BACKUP_SIGNING_KEY=

# Identifier of active signing key (e.g. prod-2026-v1)
ORCHESTRATOR_BACKUP_SIGNING_KEY_ID=default

# Keyring JSON mapping '{"key_id": "secret", ...}' for historical verification across key rotations
ORCHESTRATOR_BACKUP_VERIFICATION_KEYS=

# Strict production signature mode (reject unsigned manifests or missing verification keys)
ORCHESTRATOR_BACKUP_REQUIRE_SIGNATURE=false

# -----------------------------------------------------------------------------
# 5. Human-in-the-Loop (HITL) & Review Authentication
# -----------------------------------------------------------------------------
# Specialist confidence threshold below which tasks escalate to human review (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.6

# Specialist output quality score below which tasks escalate to human review (0.0 - 1.0)
QUALITY_THRESHOLD=0.6

# Specialist retry attempts within a workflow before escalating
MAX_RETRIES=2

# Require authenticated reviewer credentials for HITL decisions (secure by default)
REVIEW_AUTH_ENABLED=true

# Comma-separated 'name:token' pairs for reviewer authentication
# Example: dev_admin:dev_token_12345,reviewer_bob:bob_secret_token
REVIEW_USERS=dev_admin:dev_token_12345

# Reviewer session expiration in minutes (0 to disable expiry)
REVIEW_SESSION_TIMEOUT_MINUTES=15

# -----------------------------------------------------------------------------
# 6. Tool Approval Lifecycles & Distributed Admission Leases
# -----------------------------------------------------------------------------
# Default timeout in seconds for pending tool approval requests (1.0 - 86400.0)
TOOL_APPROVAL_TIMEOUT_SECONDS=3600.0

# Maximum permitted expiration horizon in seconds for tool approval requests
TOOL_APPROVAL_MAX_EXPIRATION_SECONDS=86400.0

# Interval in seconds between automated sweeps for expired tool approval requests
TOOL_APPROVAL_SWEEPER_INTERVAL_SECONDS=60.0

# Distributed lease duration in seconds for specialist admission control
ADMISSION_LEASE_DURATION_SECONDS=30.0

# Renewal interval in seconds for active specialist admission leases
ADMISSION_LEASE_RENEWAL_INTERVAL_SECONDS=10.0

# Threshold in seconds after which an unrenewed admission lease is considered stale
ADMISSION_STALE_LEASE_THRESHOLD_SECONDS=60.0

# -----------------------------------------------------------------------------
# 7. HTTP REST API Server & Authentication
# -----------------------------------------------------------------------------
# Host and port for the FastAPI service
API_HOST=127.0.0.1
API_PORT=8000

# Secret Bearer token for API access (e.g. Authorization: Bearer <token>)
# Optional for loopback (127.0.0.1) development, required when binding to 0.0.0.0
# Must be at least 16 characters in production environments
ORCHESTRATOR_API_TOKEN=

# Previous token accepted concurrently during zero-downtime token rotation
ORCHESTRATOR_API_TOKEN_PREVIOUS=

# Maximum allowed request payload body in bytes (default: 1MB = 1,000,000 bytes)
API_MAX_BODY_BYTES=1000000

# In-memory sliding-window rate limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60.0

# Allowed CORS origins (comma-separated, matches Streamlit dashboard default)
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Trusted proxy IPs for client IP resolution in rate limiting
API_TRUSTED_PROXIES=127.0.0.1,::1,localhost

# Perform interrupted run recovery during API startup
API_RECOVERY_ON_STARTUP=true

# Grace period in seconds for draining active runs during server shutdown
API_SHUTDOWN_GRACE_SECONDS=5.0

# -----------------------------------------------------------------------------
# 8. Audit Log Retention & Cleanup
# -----------------------------------------------------------------------------
# Maximum age in days to retain immutable audit trail records
AUDIT_RETENTION_DAYS=90

# Purge expired audit events during service startup
AUDIT_CLEANUP_ON_STARTUP=false

# -----------------------------------------------------------------------------
# 9. Distributed Background Execution (Celery + Redis)
# -----------------------------------------------------------------------------
# Execution backend: 'sync' (inline synchronous) or 'celery' (distributed background)
ORCHESTRATOR_WORKFLOW_EXECUTION_BACKEND=sync

# Explicit Celery activation flag
CELERY_ENABLED=false

# Celery message broker and result backend URLs (redis://, rediss://, amqp://)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Default task queue name for Celery workflow jobs
CELERY_TASK_DEFAULT_QUEUE=orchestrator_workflows

# Number of concurrent execution processes/threads per Celery worker
CELERY_WORKER_CONCURRENCY=4

# Execute tasks inline for local testing (MUST be false in distributed production)
CELERY_ALWAYS_EAGER=false

# Celery worker observability and recovery parameters
CELERY_WORKER_HEARTBEAT_INTERVAL_SECONDS=15.0
CELERY_WORKER_STALE_THRESHOLD_SECONDS=60.0
CELERY_WORKFLOW_STUCK_THRESHOLD_SECONDS=300.0
CELERY_RECOVERY_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# 10. Outbox Dispatcher & Outbound Webhook Delivery
# -----------------------------------------------------------------------------
# Enable transactional outbox pattern for reliable event publishing
OUTBOX_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_SECONDS=5.0
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BACKOFF_SECONDS=2.0
OUTBOX_MAX_BACKOFF_SECONDS=60.0
OUTBOX_RETENTION_DAYS=14
OUTBOX_CLEANUP_INTERVAL_SECONDS=3600.0
OUTBOX_DRAIN_ON_SHUTDOWN=true

# Notification provider: 'none' (default), 'log', or 'webhook'
NOTIFICATION_PROVIDER=none

# Webhook delivery endpoint (https:// required in production)
NOTIFICATION_WEBHOOK_URL=

# Static authorization bearer token for destination webhook endpoint
NOTIFICATION_WEBHOOK_AUTH_TOKEN=

# HMAC-SHA256 signing secret for outbound webhook payload verification
NOTIFICATION_WEBHOOK_SIGNING_SECRET=

# Previous signing secret accepted during zero-downtime secret rotation
NOTIFICATION_WEBHOOK_SIGNING_SECRET_PREVIOUS=

# Webhook HTTP client transport settings
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10.0
NOTIFICATION_WEBHOOK_MAX_RETRIES=3
NOTIFICATION_WEBHOOK_RETRY_BACKOFF_SECONDS=2.0
NOTIFICATION_WEBHOOK_MAX_BACKOFF_SECONDS=60.0
NOTIFICATION_WEBHOOK_TLS_VERIFY=true
NOTIFICATION_WEBHOOK_ALLOW_INSECURE_HTTP=false

# Durable replay protection cache backend: 'sqlite' or 'memory'
WEBHOOK_REPLAY_STORE_BACKEND=sqlite
WEBHOOK_REPLAY_RETENTION_SECONDS=86400.0
WEBHOOK_REPLAY_CLEANUP_INTERVAL_SECONDS=3600.0
WEBHOOK_REPLAY_CLEANUP_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# 11. Optional Backing Services (Docker Compose)
# -----------------------------------------------------------------------------
# Working memory & review queue (degrades to in-memory store if unavailable)
REDIS_URL=redis://localhost:6379/0

# Relational persistence store (degrades gracefully if unavailable)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator

# Semantic vector memory store (degrades to in-memory store if unavailable)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# -----------------------------------------------------------------------------
# 12. Observability & Telemetry
# -----------------------------------------------------------------------------
# OpenTelemetry OTLP collector endpoint (e.g. http://localhost:4317)
# When empty, spans are safely emitted to console or logger without failing runs
OTEL_EXPORTER_OTLP_ENDPOINT=

# Telemetry service identifier
OTEL_SERVICE_NAME=multi-agent-orchestrator
